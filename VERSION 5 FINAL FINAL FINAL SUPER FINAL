    audioPlayer.pause();
});

musicMinimizeBtn.addEventListener("click", function() {
    musicWindow.classList.add("hidden");
});

musicFile.addEventListener("change", function() {
    const file = musicFile.files[0];

    if (!file) {
        return;
    }

    if (!file.type.startsWith("audio/")) {
        musicTitle.textContent = "Invalid audio file";
        musicFile.value = "";
        return;
    }

    if (audioPlayer.src) {
        URL.revokeObjectURL(audioPlayer.src);
    }

    const objectURL = URL.createObjectURL(file);

    audioPlayer.src = objectURL;
    audioPlayer.load();

    musicTitle.textContent = file.name;
    musicProgress.value = 0;
    musicPlay.textContent = "Play";
});

musicPlay.addEventListener("click", async function() {
    if (!audioPlayer.src) {
        musicFile.click();
        return;
    }

    try {
        if (audioPlayer.paused) {
            await audioPlayer.play();
            musicPlay.textContent = "Pause";
        } else {
            audioPlayer.pause();
            musicPlay.textContent = "Play";
        }
    } catch {
        musicPlay.textContent = "Play";
    }
});

audioPlayer.addEventListener("loadedmetadata", function() {
    musicProgress.value = 0;
});

audioPlayer.addEventListener("timeupdate", function() {
    if (!Number.isFinite(audioPlayer.duration) || audioPlayer.duration <= 0) {
        return;
    }

    musicProgress.value =
        (audioPlayer.currentTime / audioPlayer.duration) * 100;
});

audioPlayer.addEventListener("play", function() {
    musicPlay.textContent = "Pause";
});

audioPlayer.addEventListener("pause", function() {
    musicPlay.textContent = "Play";
});

audioPlayer.addEventListener("ended", function() {
    musicPlay.textContent = "Play";
    musicProgress.value = 0;
});

musicProgress.addEventListener("input", function() {
    if (!Number.isFinite(audioPlayer.duration) || audioPlayer.duration <= 0) {
        return;
    }

    audioPlayer.currentTime =
        (Number(musicProgress.value) / 100) * audioPlayer.duration;
});

musicVolume.addEventListener("input", function() {
    audioPlayer.volume = Number(musicVolume.value);
});

const ctx = gameCanvas.getContext("2d");

let bird = null;
let pipes = [];
let score = 0;
let gameRunning = false;
let gameStarted = false;
let gameAnimation = null;
let lastFrameTime = 0;
let pipeTimer = 0;

function resizeGame() {
    const rect = gameCanvas.getBoundingClientRect();

    if (rect.width <= 0 || rect.height <= 0) {
        return;
    }

    const oldWidth = gameCanvas.width || rect.width;
    const oldHeight = gameCanvas.height || rect.height;

    gameCanvas.width = Math.floor(rect.width);
    gameCanvas.height = Math.floor(rect.height);

    if (bird) {
        bird.x = gameCanvas.width * 0.2;
        bird.y = Math.min(
            Math.max(bird.y * (gameCanvas.height / oldHeight), 0),
            gameCanvas.height - bird.height
        );
    }

    if (oldWidth !== gameCanvas.width) {
        pipes = pipes.map(pipe => ({
            ...pipe,
            x: pipe.x * (gameCanvas.width / oldWidth)
        }));
    }

    drawGame();
}

function resetGame() {
    if (gameAnimation) {
        cancelAnimationFrame(gameAnimation);
        gameAnimation = null;
    }

    resizeGame();

    bird = {
        x: gameCanvas.width * 0.2,
        y: gameCanvas.height * 0.45,
        width: 45,
        height: 45,
        velocity: 0
    };

    pipes = [];
    score = 0;
    gameRunning = false;
    gameStarted = false;
    lastFrameTime = 0;
    pipeTimer = 0;

    gameScore.textContent = "0";
    gameMessage.textContent = "click to play or spress space";

    drawGame();
}

function startFlappyGame() {
    if (gameRunning) {
        return;
    }

    if (!bird) {
        resetGame();
    }

    gameStarted = true;
    gameRunning = true;
    gameMessage.textContent = "";
    lastFrameTime = performance.now();

    gameAnimation = requestAnimationFrame(gameLoop);
}

function flap() {
    if (!gameStarted) {
        startFlappyGame();
    }

    if (gameRunning && bird) {
        bird.velocity = -420;
    }
}

function createPipe() {
    const gap = Math.max(125, Math.min(170, gameCanvas.height * 0.28));
    const minTop = 45;
    const maxTop = Math.max(minTop + 1, gameCanvas.height - gap - 55);
    const top = minTop + Math.random() * (maxTop - minTop);

    pipes.push({
        x: gameCanvas.width + 20,
        width: 62,
        top: top,
        bottom: top + gap,
        passed: false
    });
}

function gameOver() {
    gameRunning = false;
    gameStarted = true;

    if (gameAnimation) {
        cancelAnimationFrame(gameAnimation);
        gameAnimation = null;
    }

    gameMessage.textContent = "Game Over";
}

function updateGame(delta) {
    if (!gameRunning || !bird) {
        return;
    }

    bird.velocity += 1350 * delta;
    bird.y += bird.velocity * delta;

    pipeTimer += delta;

    if (pipeTimer >= 1.55) {
        createPipe();
        pipeTimer = 0;
    }

    const speed = Math.max(180, gameCanvas.width * 0.48);

    for (const pipe of pipes) {
        pipe.x -= speed * delta;

        const birdRight = bird.x + bird.width;
        const birdBottom = bird.y + bird.height;
        const pipeRight = pipe.x + pipe.width;

        const horizontalCollision =
            birdRight > pipe.x &&
            bird.x < pipeRight;

        const verticalCollision =
            bird.y < pipe.top ||
            birdBottom > pipe.bottom;

        if (horizontalCollision && verticalCollision) {
            gameOver();
            return;
        }

        if (!pipe.passed && pipeRight < bird.x) {
            pipe.passed = true;
            score++;
            gameScore.textContent = score;
        }
    }

    pipes = pipes.filter(pipe => pipe.x + pipe.width > -20);

    if (
        bird.y <= 0 ||
        bird.y + bird.height >= gameCanvas.height
    ) {
        gameOver();
    }
}

function drawGame() {
    if (!gameCanvas.width || !gameCanvas.height) {
        return;
    }

    ctx.clearRect(
        0,
        0,
        gameCanvas.width,
        gameCanvas.height
    );

    const sky = ctx.createLinearGradient(
        0,
        0,
        0,
        gameCanvas.height
    );

    sky.addColorStop(0, "#69c8ff");
    sky.addColorStop(1, "#d9f5ff");

    ctx.fillStyle = sky;

    ctx.fillRect(
        0,
        0,
        gameCanvas.width,
        gameCanvas.height
    );

    ctx.fillStyle = "#35a844";

    for (const pipe of pipes) {
        ctx.fillRect(
            pipe.x,
            0,
            pipe.width,
            pipe.top
        );

        ctx.fillRect(
            pipe.x,
            pipe.bottom,
            pipe.width,
            gameCanvas.height - pipe.bottom
        );

        ctx.fillStyle = "#2d913a";

        ctx.fillRect(
            pipe.x - 5,
            pipe.top - 18,
            pipe.width + 10,
            18
        );

        ctx.fillRect(
            pipe.x - 5,
            pipe.bottom,
            pipe.width + 10,
            18
        );

        ctx.fillStyle = "#35a844";
    }

    if (!bird) {
        return;
    }

    ctx.save();

    ctx.translate(
        bird.x + bird.width / 2,
        bird.y + bird.height / 2
    );

    const rotation =
        Math.max(
            -0.45,
            Math.min(1.0, bird.velocity / 700)
        );

    ctx.rotate(rotation);

    ctx.drawImage(
        birdImage,
        -bird.width / 2,
        -bird.height / 2,
        bird.width,
        bird.height
    );

    ctx.restore();
}

function gameLoop(timestamp) {
    if (!gameRunning) {
        return;
    }

    const delta = Math.min(
        (timestamp - lastFrameTime) / 1000,
        0.033
    );

    lastFrameTime = timestamp;

    updateGame(delta);
    drawGame();

    if (gameRunning) {
        gameAnimation = requestAnimationFrame(gameLoop);
    } else {
        gameAnimation = null;
        drawGame();
    }
}
