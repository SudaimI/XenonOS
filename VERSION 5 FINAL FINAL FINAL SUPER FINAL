        if (!e.repeat) {
            flap();
        }
    }
});

restartGame.addEventListener("click", function(e) {
    e.preventDefault();
    e.stopPropagation();
    resetGame();
});

gameCloseBtn.addEventListener("click", function() {
    gameWindow.classList.add("hidden");
    gameRunning = false;

    if (gameAnimation) {
        cancelAnimationFrame(gameAnimation);
        gameAnimation = null;
    }
});

gameMinimizeBtn.addEventListener("click", function() {
    gameWindow.classList.add("hidden");
    gameRunning = false;

    if (gameAnimation) {
        cancelAnimationFrame(gameAnimation);
        gameAnimation = null;
    }
});

const resizeObserver = new ResizeObserver(function() {
    if (!gameWindow.classList.contains("hidden")) {
        resizeGame();
    }
});

resizeObserver.observe(document.querySelector(".game-content"));

window.addEventListener("resize", function() {
    if (!gameWindow.classList.contains("hidden")) {
        resizeGame();
    }
});

lucide.createIcons();

requestAnimationFrame(function() {
    resizeGame();
    resetGame();
});

