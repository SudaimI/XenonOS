let highestZ = 20;

function bringToFront(element) {
    highestZ++;
    element.style.zIndex = highestZ;
}

function makeDraggable(element, titlebar) {
    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    titlebar.addEventListener("mousedown", function(e) {
        if (e.target.closest(".window-button")) {
            return;
        }

        dragging = true;
        offsetX = e.clientX - element.offsetLeft;
        offsetY = e.clientY - element.offsetTop;

        bringToFront(element);
        e.preventDefault();
    });

    document.addEventListener("mousemove", function(e) {
        if (!dragging) {
            return;
        }

        const maxX = window.innerWidth - element.offsetWidth;
        const maxY = window.innerHeight - element.offsetHeight;

        const newX = Math.max(0, Math.min(e.clientX - offsetX, maxX));
        const newY = Math.max(0, Math.min(e.clientY - offsetY, maxY));

        element.style.left = `${newX}px`;
        element.style.top = `${newY}px`;
    });

    document.addEventListener("mouseup", function() {
        dragging = false;
    });

    element.addEventListener("mousedown", function() {
        bringToFront(element);
    });
}

makeDraggable(welcomeWindow, welcomeTitlebar);
makeDraggable(browserWindow, browserTitlebar);
makeDraggable(musicWindow, musicTitlebar);
