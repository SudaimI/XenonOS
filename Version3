```
<div id="browserWindow" class="desktop-window">

    <div id="browserTitlebar" class="titlebar">

        <span class="title">Browser</span>

        <div class="window-controls">

            <button
                id="browserMinimizeBtn"
                class="window-button minimize-button"
                title="Minimize">
                _
            </button>

            <button
                id="browserCloseBtn"
                class="window-button close-button"
                title="Close">
                X
            </button>

        </div>

    </div>

    <div class="content">

        <div class="browser-bar">

            <input
                type="text"
                id="urlBar"
                placeholder="https://example.com"
                value="https://example.com"
            >

            <button id="goBtn">
                Go
            </button>

        </div>

        <iframe
            id="browserFrame"
            src="https://example.com"
            title="Browser">
        </iframe>

    </div>

</div>

<div id="startMenu">

    <div class="start-title">
        Applications
    </div>

    <div class="app-grid">

        <button id="startBrowser" class="app-button">
            <span class="app-icon">🌐</span>
            <span class="app-name">Browser</span>
        </button>

        <button id="startGame" class="app-button">
            <span class="app-icon">🎮</span>
            <span class="app-name">Game</span>
        </button>

        <button id="startMusic" class="app-button">
            <span class="app-icon">🎵</span>
            <span class="app-name">Music</span>
        </button>

    </div>

</div>

<div id="taskbar">

    <button
        id="startButton"
        class="taskbar-button">
        <span id="startIcon">⊞</span>
        <span>Start</span>
    </button>

    <button
        id="reopenBrowserBtn"
        class="taskbar-button">
        Browser
    </button>

</div>

<script>

    const browserWindow =
        document.getElementById("browserWindow");

    const browserTitlebar =
        document.getElementById("browserTitlebar");

    const browserCloseBtn =
        document.getElementById("browserCloseBtn");

    const browserMinimizeBtn =
        document.getElementById("browserMinimizeBtn");

    const reopenBrowserBtn =
        document.getElementById("reopenBrowserBtn");

    const urlBar =
        document.getElementById("urlBar");

    const goBtn =
        document.getElementById("goBtn");

    const browserFrame =
        document.getElementById("browserFrame");

    const startButton =
        document.getElementById("startButton");

    const startMenu =
        document.getElementById("startMenu");

    const startBrowser =
        document.getElementById("startBrowser");

    const startGame =
        document.getElementById("startGame");

    const startMusic =
        document.getElementById("startMusic");


    let isDraggingBrowser = false;
    let offsetXB = 0;
    let offsetYB = 0;


    browserTitlebar.addEventListener("mousedown", (e) => {

        if (e.target.closest(".window-button")) {
            return;
        }

        isDraggingBrowser = true;

        offsetXB =
            e.clientX -
            browserWindow.offsetLeft;

        offsetYB =
            e.clientY -
            browserWindow.offsetTop;

        browserWindow.style.zIndex = 101;

    });


    document.addEventListener("mousemove", (e) => {

        if (isDraggingBrowser) {

            browserWindow.style.left =
                `${e.clientX - offsetXB}px`;

            browserWindow.style.top =
                `${e.clientY - offsetYB}px`;

            browserWindow.style.transform =
                "none";

        }

    });


    document.addEventListener("mouseup", () => {

        isDraggingBrowser = false;

    });


    browserCloseBtn.addEventListener("click", () => {

        browserWindow.classList.add("hidden");

    });


    browserMinimizeBtn.addEventListener("click", () => {

        browserWindow.classList.add("hidden");

    });


    reopenBrowserBtn.addEventListener("click", () => {

        browserWindow.classList.remove("hidden");

        browserWindow.style.zIndex = 101;

    });


    startButton.addEventListener("click", (e) => {

        e.stopPropagation();

        startMenu.classList.toggle("open");

    });


    startBrowser.addEventListener("click", () => {

        browserWindow.classList.remove("hidden");

        browserWindow.style.zIndex = 101;

        startMenu.classList.remove("open");

    });


    startGame.addEventListener("click", () => {

        startMenu.classList.remove("open");

    });


    startMusic.addEventListener("click", () => {

        startMenu.classList.remove("open");

    });


    document.addEventListener("click", (e) => {

        if (
            !startMenu.contains(e.target) &&
            e.target !== startButton
        ) {
            startMenu.classList.remove("open");
        }

    });


    function loadWebsite() {

        let url =
            urlBar.value.trim();

        if (!url) {
            return;
        }

        if (
            !url.startsWith("http://") &&
            !url.startsWith("https://")
        ) {
            url = "https://" + url;
        }

        urlBar.value = url;

        browserFrame.src = url;

    }


    goBtn.addEventListener("click", loadWebsite);


    urlBar.addEventListener("keydown", (e) => {

        if (e.key === "Enter") {
            loadWebsite();
        }

    });

</script>
